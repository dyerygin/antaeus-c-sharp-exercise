          "raw": "{\n  \"name\": \"\",\n  \"image\": \"not-a-url\"\n}"
        }
      }
    },
    {
      "name": "Create category with an Idempotency-Key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201 with Location', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Location')).to.match(/\\/api\\/v1\\/categories\\/\\d+$/); });",
              "pm.test('not a replay', () => pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false);",
              "pm.collectionVariables.set('categoryLocation', pm.response.headers.get('Location'));",
              "pm.collectionVariables.set('categoryBody', pm.response.text());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Newman Category\",\n  \"image\": \"https://placehold.co/600x400\"\n}"
        }
      }
    },
    {
      "name": "Get the created category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('same fields as created', () => { const created = JSON.parse(pm.collectionVariables.get('categoryBody')); const fetched = pm.response.json(); pm.expect(fetched.id).to.eql(created.id); pm.expect(fetched.name).to.eql(created.name); pm.expect(fetched.image).to.eql(created.image); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{categoryLocation}}"
      }
    },
    {
      "name": "Same key and body replays",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('Idempotent-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
              "pm.test('same body as the first create', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('categoryBody')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
