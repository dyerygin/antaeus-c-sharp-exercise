{
  "info": {
    "_postman_id": "5f0c2b1e-3c55-4d8e-9a43-6f1d2c7b9e10",
    "name": "CSharpApp API smoke",
    "description": "Black-box checks against the running containers (docker compose). Run: newman run docs/postman/CSharpApp.postman_collection.json -e docs/postman/CSharpApp.local.postman_environment.json --env-var apiKey=<API_KEY from .env>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('security headers', () => {",
          "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
          "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
          "  pm.expect(pm.response.headers.get('Referrer-Policy')).to.eql('no-referrer');",
          "});",
          "pm.test('no Server header', () => pm.expect(pm.response.headers.has('Server')).to.be.false);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "categoryLocation",
      "value": ""
    },
    {
      "key": "categoryBody",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/live"
      }
    },
    {
      "name": "Readiness (upstream reached with a token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('upstream healthy', () => pm.expect(pm.response.json().checks.map(c => c.name)).to.include('upstream'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/ready"
      }
    },
    {
      "name": "Products: one page",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('at most 5 products', () => { const body = pm.response.json(); pm.expect(body).to.be.an('array'); pm.expect(body.length).to.be.at.most(5); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/products?limit=5"
      }
    },
    {
      "name": "Products: limit over 100 is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "pm.test('ProblemDetails with traceId', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json()).to.have.property('traceId');",
              "});",
              "pm.test('errors.limit', () => pm.expect(pm.response.json().errors).to.have.property('limit'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/products?limit=101"
      }
    },
    {
      "name": "Products: unknown id is 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));",
