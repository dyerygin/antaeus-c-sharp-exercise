# Local requests against `dotnet run` (Development: upstream = the mock on localhost:5081).
@HostAddress = http://localhost:5225
@Version = v1

### List products (default page size 20)
GET {{HostAddress}}/api/{{Version}}/products
Accept: application/json

### One page
GET {{HostAddress}}/api/{{Version}}/products?offset=0&limit=5
Accept: application/json

### One product
GET {{HostAddress}}/api/{{Version}}/products/1
Accept: application/json

### Unknown product → 404 ProblemDetails
GET {{HostAddress}}/api/{{Version}}/products/999999
Accept: application/json

### Invalid limit → 400 with errors.limit
GET {{HostAddress}}/api/{{Version}}/products?limit=101
Accept: application/json

### Create a product → 201 with Location; the price is the stored (whole-number) value
POST {{HostAddress}}/api/{{Version}}/products
Content-Type: application/json

{
  "title": "Lamp",
  "price": 10.5,
  "description": "A desk lamp",
  "categoryId": 1,
  "images": ["https://placehold.co/600x400"]
}

### Unknown category → 400 with errors.categoryId
POST {{HostAddress}}/api/{{Version}}/products
Content-Type: application/json

{
  "title": "Lamp",
  "price": 10,
  "description": "A desk lamp",
  "categoryId": 999999,
  "images": ["https://placehold.co/600x400"]
}

### List categories (default 20)
GET {{HostAddress}}/api/{{Version}}/categories
Accept: application/json

### One category
GET {{HostAddress}}/api/{{Version}}/categories/1
Accept: application/json

### Create a category → 201 with Location (no read-back: stored as sent)
POST {{HostAddress}}/api/{{Version}}/categories
Content-Type: application/json

{
  "name": "Books",
  "image": "https://placehold.co/600x400"
}
