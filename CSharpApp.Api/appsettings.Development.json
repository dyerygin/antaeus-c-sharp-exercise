{
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ApiAuth": {
    "Keys": [
      {
        "ClientId": "local-dev",
        "Key": "local-dev-api-key-not-a-secret-0000"
      }
    ]
  },
  "RestApiSettings": {
    "BaseUrl": "http://localhost:5081/api/v1/"
  }
}
