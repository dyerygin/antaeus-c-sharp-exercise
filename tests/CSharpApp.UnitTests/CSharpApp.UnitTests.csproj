<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test data builders shared by the unit and integration tests. -->
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CSharpApp.Application\CSharpApp.Application.csproj" />
    <ProjectReference Include="..\..\CSharpApp.Core\CSharpApp.Core.csproj" />
    <ProjectReference Include="..\..\CSharpApp.Infrastructure\CSharpApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
