# Settings for docker compose. Copy to .env (git-ignored):
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)

# The public demo account of the upstream contract (ASM-03): not a secret; the mock seeds it.
UPSTREAM_USERNAME=john@mail.com
UPSTREAM_PASSWORD=changeme

# Demo key the write endpoints require in the X-Api-Key header (ADR-0012). Replace it outside a local demo.
API_KEY=local-demo-api-key-not-a-secret-0001

# Host ports.
API_PORT=8080
MOCK_PORT=8081

# Requests per client per window on /api (ADR-0016).
RATE_LIMIT_PERMITS=100
